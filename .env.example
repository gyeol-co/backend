ENV=local

# DB / Redis — 실제 비밀번호는 /deploy/.env 참조 (POSTGRES_PASSWORD, REDIS_PASSWORD)
DATABASE_URL=postgresql+asyncpg://gyeol:<POSTGRES_PASSWORD>@localhost:5432/gyeol
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0

SESSION_SECRET=change-me-to-random-32-bytes

COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# AWS S3 — product images
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_BUCKET=gyeol
S3_PUBLIC_BASE_URL=https://gyeol.s3.ap-southeast-2.amazonaws.com

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/auth/oauth/kakao/callback

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8000/auth/oauth/naver/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback
